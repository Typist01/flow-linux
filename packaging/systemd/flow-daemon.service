[Unit]
Description=Flow Linux dictation daemon
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
# Install the binary to ~/.local/bin or set ExecStart to your AppImage path.
ExecStart=%h/.local/bin/flow-daemon
Restart=on-failure
RestartSec=3
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
